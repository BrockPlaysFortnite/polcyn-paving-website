---
import { companyInfo } from '../data/services';
import { withBase } from '../lib/links';

const navItems = [
  { label: 'Home', href: withBase('/') },
  { label: 'Services', href: withBase('/services') },
  { label: 'Contact', href: withBase('/contact') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized || (normalized !== '/' && normalized !== withBase('/').replace(/\/$/, '') && currentPath.startsWith(normalized));
};
---

<!-- Top bar with phone/email -->
<div class="bg-black text-white text-sm py-2">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
    <div class="flex items-center gap-4">
      <span class="text-gray-400 italic hidden sm:inline">Call or text — free estimates!</span>
      <a href={`tel:${companyInfo.phoneRaw}`} class="flex items-center gap-1.5 hover:text-primary transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        {companyInfo.phone}
      </a>
      <a href={`mailto:${companyInfo.email}`} class="hidden sm:flex items-center gap-1.5 hover:text-primary transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        {companyInfo.email}
      </a>
    </div>
    <div class="text-gray-400 hidden md:block">
      Serving the Inland Empire & High Desert
    </div>
  </div>
</div>

<!-- Main navigation -->
<header class="bg-white sticky top-0 z-50 shadow-md" id="main-header">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-18">
      <!-- Logo / wordmark — TODO: replace placeholder with logo image when supplied -->
      <a href={withBase('/')} class="flex-shrink-0 mr-8 py-3" title="[LOGO PLACEHOLDER — send a logo file if you have one]">
        <div class="flex items-center gap-2">
          <div class="w-10 h-10 bg-primary rounded-md flex items-center justify-center border-2 border-dashed border-black/30">
            <span class="text-black font-black text-xl">P</span>
          </div>
          <div class="flex flex-col leading-tight">
            <span class="font-black text-black text-lg">Polcyn's Paving</span>
            <span class="text-slate text-xs uppercase tracking-wider">Co. <span class="text-primary normal-case font-semibold">[logo TBD]</span></span>
          </div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              "px-4 py-2 text-sm font-medium rounded-md transition-colors whitespace-nowrap",
              isActive(item.href)
                ? "text-primary bg-black"
                : "text-black hover:text-primary hover:bg-smoke"
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile toggle -->
      <div class="flex items-center gap-3">
        <a
          href={`tel:${companyInfo.phoneRaw}`}
          class="bg-primary hover:bg-primary-dark text-white font-bold px-3 py-1.5 rounded-md text-xs sm:px-5 sm:py-2.5 sm:text-sm transition-colors whitespace-nowrap"
        >
          Free Estimate
        </a>
        <button
          id="mobile-toggle"
          class="lg:hidden p-2 rounded-md hover:bg-smoke transition-colors cursor-pointer"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100">
    <nav class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[
            "px-4 py-3 rounded-md text-base font-medium transition-colors",
            isActive(item.href)
              ? "text-primary bg-black"
              : "text-black hover:bg-smoke"
          ]}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 pt-3 border-t border-gray-100">
        <a href={`tel:${companyInfo.phoneRaw}`} class="flex items-center gap-2 px-4 py-3 text-base font-semibold text-black">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          {companyInfo.phone}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
