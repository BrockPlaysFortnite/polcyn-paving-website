---
import { companyInfo } from '../data/services';

interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaLink?: string;
  showCallButton?: boolean;
  backgroundImage?: string;
  backgroundOpacity?: string;
  compact?: boolean;
}

const {
  title,
  subtitle,
  ctaText,
  ctaLink,
  showCallButton = true,
  backgroundImage,
  backgroundOpacity = "opacity-30",
  compact = false,
} = Astro.props;
---

<section class:list={["relative bg-black overflow-hidden", compact ? "py-20" : "py-28 md:py-36"]}>
  {backgroundImage && (
    <img
      src={backgroundImage}
      alt=""
      class={`absolute inset-0 w-full h-full object-cover ${backgroundOpacity}`}
      loading="eager"
    />
  )}
  {!backgroundImage && (
    <>
      <!-- TODO: replace gradient with hero photo when supplied -->
      <div class="absolute inset-0 bg-gradient-to-br from-black via-charcoal to-black"></div>
      <!-- Subtle diagonal pattern for "asphalt" texture -->
      <div class="absolute inset-0 opacity-[0.07]" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 12px, #fff 12px, #fff 13px);"></div>
      <!-- Photo placeholder hint, sits in the corner so it doesn't clobber the headline -->
      <div class="absolute top-4 right-4 bg-yellow-300 text-black text-xs font-bold px-3 py-1.5 rounded-md border border-black/40 shadow-md z-10">
        [HERO PHOTO GOES HERE]
      </div>
    </>
  )}
  <!-- Orange accent line -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-primary"></div>

  <div class="relative max-w-7xl mx-auto px-4 text-center">
    <h1 class:list={["font-black text-white mb-4", compact ? "text-3xl md:text-4xl" : "text-4xl md:text-5xl lg:text-6xl"]}>
      {title}
    </h1>
    {subtitle && (
      <p class:list={["text-gray-300 max-w-2xl mx-auto", compact ? "text-lg mb-6" : "text-lg md:text-xl mb-8"]}>
        {subtitle}
      </p>
    )}
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      {showCallButton && (
        <a
          href={`tel:${companyInfo.phoneRaw}`}
          class="bg-primary hover:bg-primary-dark text-white font-bold px-8 py-4 rounded-md text-lg transition-colors"
        >
          Call {companyInfo.phone}
        </a>
      )}
      {ctaText && ctaLink && (
        <a
          href={ctaLink}
          class="border-2 border-white text-white hover:bg-white hover:text-black font-bold px-8 py-4 rounded-md text-lg transition-colors"
        >
          {ctaText}
        </a>
      )}
    </div>
  </div>
</section>
