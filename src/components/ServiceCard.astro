---
import { withBase } from '../lib/links';

interface Props {
  name: string;
  slug: string;
  description: string;
  icon: string;
  href?: string;
}

const { name, slug, description, icon, href } = Astro.props;
const linkHref = href ?? withBase(`/services#${slug}`);

const icons: Record<string, string> = {
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  lines: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />`,
  accessible: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  wrench: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
  // Paving — road / dashed lane lines
  paving: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M6 21l2-16M18 21l-2-16M12 5v2M12 11v2M12 17v2" />`,
  // Signs — sign on post
  signs: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7M9 21h6M5 4h11l3 3-3 3H5V4z" />`,
};
---

<a href={linkHref} class="group block bg-white rounded-xl shadow-md hover:shadow-xl p-8 transition-all duration-300 hover:-translate-y-1 border border-gray-100">
  <div class="w-14 h-14 bg-charcoal rounded-lg flex items-center justify-center mb-5 group-hover:bg-primary transition-colors">
    <svg class="w-7 h-7 text-white group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <Fragment set:html={icons[icon] || icons.shield} />
    </svg>
  </div>
  <h3 class="text-xl font-bold text-black mb-3">{name}</h3>
  <p class="text-slate text-sm leading-relaxed mb-4">{description}</p>
  <span class="text-sm font-semibold text-primary group-hover:text-primary-dark transition-colors flex items-center gap-1">
    Learn More
    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
  </span>
</a>
