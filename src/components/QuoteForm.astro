---
import { companyInfo, services } from '../data/services';

interface Props {
  formId?: string;
  compact?: boolean;
}

const { formId = "quote-form", compact = false } = Astro.props;

// TODO: replace mailto fallback with a real form endpoint (Formspree, Web3Forms,
// Netlify Forms, etc.) once the friend signs up for one. Until then, the form
// opens the user's mail client pre-filled with their inputs.
const action = `mailto:${companyInfo.email}`;
---

<form
  id={formId}
  action={action}
  method="POST"
  enctype="text/plain"
  class="space-y-4"
>
  <div class:list={["grid gap-4", compact ? "grid-cols-1" : "grid-cols-1 sm:grid-cols-2"]}>
    <div>
      <label for={`${formId}-name`} class="block text-sm font-medium text-black mb-1">Name</label>
      <input
        type="text"
        id={`${formId}-name`}
        name="Name"
        required
        class="w-full px-4 py-3 rounded-md border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors text-sm"
        placeholder="Your full name"
      />
    </div>
    <div>
      <label for={`${formId}-phone`} class="block text-sm font-medium text-black mb-1">Phone</label>
      <input
        type="tel"
        id={`${formId}-phone`}
        name="Phone"
        class="w-full px-4 py-3 rounded-md border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors text-sm"
        placeholder="(555) 123-4567"
      />
    </div>
  </div>
  <div>
    <label for={`${formId}-email`} class="block text-sm font-medium text-black mb-1">Email</label>
    <input
      type="email"
      id={`${formId}-email`}
      name="Email"
      required
      class="w-full px-4 py-3 rounded-md border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors text-sm"
      placeholder="you@example.com"
    />
  </div>
  <div>
    <label for={`${formId}-service`} class="block text-sm font-medium text-black mb-1">Service Needed</label>
    <select
      id={`${formId}-service`}
      name="Service"
      class="w-full px-4 py-3 rounded-md border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors text-sm bg-white"
    >
      <option value="">Select a service...</option>
      {services.map(service => (
        <option value={service.name}>{service.name}</option>
      ))}
      <option value="Other">Other / Not Sure</option>
    </select>
  </div>
  <div>
    <label for={`${formId}-message`} class="block text-sm font-medium text-black mb-1">Project Details</label>
    <textarea
      id={`${formId}-message`}
      name="Message"
      rows="4"
      class="w-full px-4 py-3 rounded-md border border-gray-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-colors text-sm resize-y"
      placeholder="Tell us about your project — property type, approximate size, timeline, anything else we should know..."
    ></textarea>
  </div>
  <button
    type="submit"
    class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-4 px-6 rounded-md text-lg transition-colors cursor-pointer"
  >
    Send Estimate Request
  </button>
  <p class="text-xs text-slate text-center">
    This will open your email app with your message ready to send. Prefer to call? Dial <a href={`tel:${companyInfo.phoneRaw}`} class="text-primary hover:underline font-semibold">{companyInfo.phone}</a>.
  </p>
</form>
