---
// TODO: confirm years in business + license number with the friend and update
// the placeholders below.
const badges = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
    title: "Licensed & Insured",
    subtitle: "[CSLB LICENSE #]",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: "[XX]+ Years",
    subtitle: "In the paving business",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />`,
    title: "Locally Owned",
    subtitle: "Based in Southern California",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    title: "Fast Response",
    subtitle: "Call or text anytime",
  },
];
---

<section class="py-12 bg-smoke">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {badges.map(badge => (
        <div class="flex flex-col items-center text-center p-4">
          <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center mb-3">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <Fragment set:html={badge.icon} />
            </svg>
          </div>
          <h3 class="font-bold text-black text-sm md:text-base">{badge.title}</h3>
          <p class="text-slate text-xs md:text-sm">{badge.subtitle}</p>
        </div>
      ))}
    </div>
  </div>
</section>
