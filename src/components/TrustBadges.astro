---
import { icons } from '../lib/icons';

// TODO: confirm years in business + license number with the friend and update
// the placeholders below.
const badges = [
  { icon: 'shield',    title: 'Licensed & Insured',   subtitle: '[CSLB LICENSE #]' },
  { icon: 'medal',     title: '[XX]+ Years',          subtitle: 'In the paving business' },
  { icon: 'house',     title: 'Locally Owned',        subtitle: 'Based in Southern California' },
  { icon: 'lightning', title: 'Fast Response',        subtitle: 'Call or text anytime' },
];
---

<section class="py-12 bg-smoke">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {badges.map(badge => (
        <div class="flex flex-col items-center text-center p-4">
          <div class="w-14 h-14 bg-primary rounded-full flex items-center justify-center mb-3">
            <svg class="w-8 h-8 text-white" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
              <Fragment set:html={icons[badge.icon]} />
            </svg>
          </div>
          <h3 class="font-bold text-black text-sm md:text-base">{badge.title}</h3>
          <p class="text-slate text-xs md:text-sm">{badge.subtitle}</p>
        </div>
      ))}
    </div>
  </div>
</section>
