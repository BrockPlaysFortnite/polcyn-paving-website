---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/links';
---

<BaseLayout
  title="404 — Page Not Found | Polcyn's Paving Co."
  description="This page doesn't exist. Looks like you hit a pothole."
>
  <section class="py-20 md:py-32 bg-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-[10rem] md:text-[14rem] font-black leading-none text-gray-300">404</h1>
      <h2 class="text-3xl md:text-4xl font-black text-black mb-4 mt-6">Looks like you hit a pothole!</h2>
      <p class="text-slate text-lg mb-8">This page has seen better days. It might have been moved, removed, or never existed.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={withBase('/')} class="bg-primary hover:bg-primary-dark text-white font-bold px-8 py-3 rounded-lg transition-colors text-lg">
          Back to Home
        </a>
        <a href={withBase('/contact')} class="border-2 border-black text-black hover:bg-black hover:text-white font-bold px-8 py-3 rounded-lg transition-colors text-lg">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
