---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { companyInfo } from '../data/services';
---

<BaseLayout
  title="Contact Polcyn's Paving Co. | Free Estimates in Southern California"
  description="Contact Polcyn's Paving Co. for a free estimate. Call or text 760-880-0189 anytime. Serving San Bernardino, the High Desert, and the Inland Empire."
>
  <Hero
    title="Contact Us"
    subtitle="Free estimates. Straight answers. Call, text, or send us a message — we'll get right back to you."
    showCallButton={false}
    compact={true}
  />

  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-black text-black mb-8">Get In Touch</h2>

          <!-- Phone -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-black text-lg">Phone</h3>
              <a href={`tel:${companyInfo.phoneRaw}`} class="text-xl font-bold text-black hover:text-primary transition-colors">
                {companyInfo.phone}
              </a>
              <p class="text-slate text-sm mt-1">Call or text anytime!</p>
            </div>
          </div>

          <!-- Email -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-black text-lg">Email</h3>
              <a href={`mailto:${companyInfo.email}`} class="text-lg text-black hover:text-primary transition-colors break-all">
                {companyInfo.email}
              </a>
            </div>
          </div>

          <!-- Service Area -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-black text-lg">Service Area</h3>
              <p class="text-slate">{companyInfo.serviceAreas}</p>
            </div>
          </div>

          <!-- Hours -->
          <div class="flex items-start gap-4 mb-8">
            <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-black text-lg">Office Hours</h3>
              <p class="text-slate">{companyInfo.hours.weekdays}</p>
              <p class="text-slate">{companyInfo.hours.weekend}</p>
              <p class="text-slate text-sm mt-1 italic">Calls and texts welcome anytime</p>
            </div>
          </div>
        </div>

        <!-- Form -->
        <div class="bg-white rounded-xl shadow-lg p-8 border border-gray-100">
          <h2 class="text-2xl font-black text-black mb-2">Send Us a Message</h2>
          <p class="text-slate text-sm mb-6">Fill out the form below for a free, no-obligation estimate.</p>
          <QuoteForm formId="contact-form" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
