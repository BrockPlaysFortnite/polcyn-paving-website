---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustBadges from '../components/TrustBadges.astro';
import CTABanner from '../components/CTABanner.astro';
import { services, companyInfo } from '../data/services';
import { withBase } from '../lib/links';
import { icons } from '../lib/icons';
---

<BaseLayout
  title="Polcyn's Paving Co. | Asphalt Paving, Sealcoating & Striping in Southern California"
  description="Full-service asphalt paving and maintenance contractor serving San Bernardino, the High Desert, and the Inland Empire. New paving, repairs, sealcoating, striping, ADA upgrades, and more. Free estimates."
>
  <!-- Hero -->
  <Hero
    title="Full-Service Asphalt Paving & Maintenance"
    subtitle="From new paving to sealcoating and striping — Polcyn's Paving Co. gets your project to completion. Serving the High Desert and Inland Empire."
    ctaText="Our Services"
    ctaLink={withBase('/services')}
  />

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- Who We Are -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-block h-1 w-16 bg-primary mb-6"></div>
        <h2 class="text-3xl md:text-4xl font-black text-black mb-6">
          Who We Are
        </h2>
        <!-- TODO: replace placeholder copy below with the owner's actual story / years in business once confirmed -->
        <p class="text-slate text-lg leading-relaxed mb-4">
          Polcyn's Paving Co. is a Southern California asphalt contractor offering the full menu — <strong class="text-black">new installation, patching, sealcoating, striping, ADA upgrades, and sign work</strong>. One crew, one point of contact, the whole project handled.
        </p>
        <p class="text-slate text-lg leading-relaxed mb-6">
          We're committed to getting your project to completion, on time and done right. Based in {companyInfo.address}, proudly serving {companyInfo.serviceAreas}.
        </p>
        <div class="bg-yellow-100 border-l-4 border-primary p-4 mb-6 text-left rounded">
          <p class="text-sm font-semibold text-black mb-1">[YOUR STORY GOES HERE]</p>
          <p class="text-sm text-slate">
            Send David a couple sentences: how long you've been in the business, who started the company, what makes Polcyn's different, anything else you'd want a new customer to know.
          </p>
        </div>
        <a href={withBase('/services')} class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-dark transition-colors">
          See what we do
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-16 md:py-20 bg-smoke">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="inline-block h-1 w-16 bg-primary mb-6"></div>
        <h2 class="text-3xl md:text-4xl font-black text-black mb-4">Our Services</h2>
        <p class="text-slate text-lg max-w-2xl mx-auto">
          One contractor, every service your asphalt needs.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(service => (
          <ServiceCard
            name={service.name}
            slug={service.slug}
            description={service.shortDescription}
            icon={service.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <div class="inline-block h-1 w-16 bg-primary mb-6"></div>
        <h2 class="text-3xl md:text-4xl font-black text-black mb-4">Why Property Owners Pick Polcyn's</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><Fragment set:html={icons.crew} /></svg>
          </div>
          <h3 class="font-bold text-black text-lg mb-2">One Crew, Full Job</h3>
          <p class="text-slate text-sm">No subcontractor shuffle. We pave it, patch it, seal it, and stripe it ourselves.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><Fragment set:html={icons.chat} /></svg>
          </div>
          <h3 class="font-bold text-black text-lg mb-2">Straight Communication</h3>
          <p class="text-slate text-sm">Call or text anytime. We answer the phone and follow through on what we say.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7 text-white" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><Fragment set:html={icons.seal} /></svg>
          </div>
          <h3 class="font-bold text-black text-lg mb-2">Done Right the First Time</h3>
          <p class="text-slate text-sm">Proper prep, proper materials, proper cure. Asphalt that lasts is asphalt installed right.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio placeholder — TODO: replace with real gallery once photos arrive -->
  <section class="py-16 md:py-20 bg-smoke">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-10">
        <div class="inline-block h-1 w-16 bg-primary mb-6"></div>
        <h2 class="text-3xl md:text-4xl font-black text-black mb-4">Our Work</h2>
        <p class="text-slate text-lg max-w-2xl mx-auto">
          A few examples of recent jobs — fresh paving, sharp striping, and clean sealcoat work.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class="aspect-square bg-white border-2 border-dashed border-gray-300 rounded-lg flex flex-col items-center justify-center p-4 text-center">
            <svg class="w-10 h-10 text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            <p class="text-xs font-bold text-slate">[PHOTO {i + 1}]</p>
          </div>
        ))}
      </div>
      <div class="mt-8 max-w-2xl mx-auto bg-yellow-100 border-l-4 border-primary p-4 rounded text-sm">
        <p class="font-semibold text-black mb-1">[SEND DAVID 5–10 JOB PHOTOS]</p>
        <p class="text-slate">Photos from your phone are fine — finished driveways, parking lots, sealcoat jobs, striping work. Before/after pairs are gold. Anything you've got, send it over.</p>
      </div>
    </div>
  </section>

  <!-- Free Estimate Callout -->
  <section class="py-12 bg-primary">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-black text-white mb-3">Free Consultations & Estimates</h2>
      <p class="text-white/90 text-lg mb-6">
        Tell us about your project and we'll come out, take a look, and give you a straight quote — no pressure, no hidden costs.
      </p>
      <a href={withBase('/contact')} class="inline-block bg-black text-white font-bold px-8 py-3 rounded-md hover:bg-charcoal transition-colors">
        Get Your Free Estimate
      </a>
    </div>
  </section>

  <!-- Bottom CTA -->
  <CTABanner />
</BaseLayout>
