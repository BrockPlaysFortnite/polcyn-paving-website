---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTABanner from '../components/CTABanner.astro';
import { services, companyInfo } from '../data/services';

const icons: Record<string, string> = {
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  lines: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />`,
  accessible: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />`,
  wrench: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`,
  paving: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M6 21l2-16M18 21l-2-16M12 5v2M12 11v2M12 17v2" />`,
  signs: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7M9 21h6M5 4h11l3 3-3 3H5V4z" />`,
};
---

<BaseLayout
  title="Services | Polcyn's Paving Co. — Asphalt Paving, Sealcoating, Striping & More"
  description="Full-service asphalt contractor: new paving, repair and patching, sealcoating, line striping, ADA upgrades, and sign/post/bollard work. Serving San Bernardino, the High Desert, and the Inland Empire."
>
  <Hero
    title="Our Services"
    subtitle="Everything your asphalt needs — handled by one crew, start to finish."
    compact={true}
    showCallButton={false}
  />

  <!-- Service jump nav -->
  <section class="py-8 bg-smoke border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-wrap justify-center gap-2">
        {services.map(service => (
          <a
            href={`#${service.slug}`}
            class="px-4 py-2 bg-white rounded-md text-sm font-semibold text-black hover:bg-primary hover:text-white transition-colors border border-gray-200"
          >
            {service.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Service sections -->
  <div class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 space-y-16 md:space-y-20">
      {services.map((service, idx) => (
        <section id={service.slug} class="scroll-mt-24">
          <div class="flex items-start gap-5 mb-5">
            <div class="w-14 h-14 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <Fragment set:html={icons[service.icon] || icons.shield} />
              </svg>
            </div>
            <div class="flex-1">
              <span class="text-primary text-sm font-bold uppercase tracking-wider">Service {String(idx + 1).padStart(2, '0')}</span>
              <h2 class="text-3xl md:text-4xl font-black text-black mt-1">{service.name}</h2>
            </div>
          </div>
          <p class="text-slate text-lg leading-relaxed mb-4 pl-0 md:pl-[4.75rem]">
            {service.longDescription || service.shortDescription}
          </p>
          <div class="pl-0 md:pl-[4.75rem]">
            <a href={`tel:${companyInfo.phoneRaw}`} class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-dark transition-colors">
              Get a free estimate for {service.name.toLowerCase()}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </section>
      ))}
    </div>
  </div>

  <CTABanner
    headline="Got a project in mind?"
    subtext="Tell us what you need done — we'll come take a look and give you a straight estimate, free of charge."
  />
</BaseLayout>
